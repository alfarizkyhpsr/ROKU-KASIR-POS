# ============================================================
# .gitignore — ROKU-KASIR-POS
# ============================================================

# ─── Node Modules ───────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Environment & Secrets ──────────────────────────────────
# Semua .env dikecualikan KECUALI file contoh (.env.example)
.env
.env.*
!.env.example
# File .env.gcp* berisi URL Cloud Run aktif — jangan di-commit
backend/.env.gcp*
frontend/.env.gcp

# ─── NeDB / SQLite Database (data runtime lokal) ────────────
backend/data/*.db
backend/data/*.db~
# Tapi tetap track folder-nya lewat .gitkeep
!backend/data/.gitkeep

# ─── Frontend Build Output ──────────────────────────────────
frontend/dist/
frontend/.vite/

# ─── Script Deploy / Cleanup Lokal ──────────────────────────
# File ini hanya untuk keperluan lokal, tidak perlu di-repo
cleanup-gcp.ps1
deploy-final.ps1
update-deploy.ps1
LinkDeploy.md

# ─── Log Files ──────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ─── OS Files ───────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini

# ─── Editor / IDE ───────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# ─── Cache & Temp ───────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
*.tsbuildinfo
.vite/

# ─── Test Coverage ──────────────────────────────────────────
coverage/
*.lcov
.nyc_output/
